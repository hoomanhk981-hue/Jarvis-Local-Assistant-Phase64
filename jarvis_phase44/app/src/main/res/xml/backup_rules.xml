<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Jarvis stores private memory, encrypted credentials, action history and model metadata locally.
         Do not copy these app-private records into device/cloud backups. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
